# Database (docker-compose maps Postgres to host port 5433)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://srss:CHANGE_ME@localhost:5433/srss

# Auth
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Used by `npm run db:seed` to bootstrap the first SUPERADMIN account
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=

# Google sign-in (leave empty to disable POST /api/auth/google)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# License start/end dates are calendar dates evaluated in this IANA time zone
BUSINESS_TIME_ZONE=Asia/Jakarta

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Redis (OTP, reset tokens, revoked refresh tokens, telemetry dedupe)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=app:

# Forgot-password OTP
OTP_EXPIRY_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_TTL_SECONDS=900

# Mail: "log" prints the OTP to the server log (development), "smtp" sends real email
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Lone Worker Safety <no-reply@example.com>"

# IoT telemetry webhook
TELEMETRY_WEBHOOK_SECRET=
TELEMETRY_WEBHOOK_MAX_BATCH=500
TELEMETRY_DEDUPE_TTL_SECONDS=3600
